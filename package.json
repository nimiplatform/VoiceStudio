{
  "name": "omnivoice-studio-monorepo",
  "version": "0.5.5",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "check:electron": "pnpm --dir electron run typecheck && pnpm --dir electron run test",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "deps:check": "taze -r --maturity-period 7",
    "postinstall": "install-electron --no",
    "dev:renderer": "pnpm --dir electron exec vite --config nimi.vite.config.ts --host 127.0.0.1 --port 3902 --strictPort",
    "build:electron": "node scripts/build-nimi-host.mjs",
    "build:renderer": "pnpm --dir electron exec vite build --config nimi.vite.config.ts",
    "test:app": "pnpm --dir electron run typecheck && pnpm --dir electron run test && pnpm run test:protocol && pnpm run test:business && cargo test --manifest-path native/desktop-bridge/Cargo.toml --locked --release",
    "build:electron:production": "pnpm run build:renderer && node scripts/build-nimi-host.mjs --production && pnpm run build:business && node scripts/package-nimi.mjs",
    "setup:business": "node scripts/setup-business.mjs",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "sync": "nimi-app sync",
    "pack": "nimi-app pack",
    "test:business": "node scripts/test-business.mjs",
    "build:business": "node scripts/build-business.mjs",
    "test:protocol": "node scripts/test-electron-protocol.mjs"
  },
  "devDependencies": {
    "concurrently": "^10",
    "playwright": "^1.63.0",
    "taze": "^21",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0",
    "@electron/packager": "^20.3.0",
    "electron": "^42.10.1",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.0",
    "@types/node": "^24.13.3",
    "@nimiplatform/app-tools": "^0.7.5",
    "@nimiplatform/nimi-coding": "0.6.3"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "word-extractor": "1.0.4",
    "@nimiplatform/sdk": "^0.15.0",
    "@nimiplatform/kit": "^0.11.0"
  },
  "author": "VoiceStudio contributors"
}
